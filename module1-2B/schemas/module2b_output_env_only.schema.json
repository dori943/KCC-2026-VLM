{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/module2b_output_env_only.schema.json",
  "title": "module2b_output_env_only",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "stage",
    "task_id",
    "target_binding",
    "environment_context",
    "derived_constraints",
    "module3_handoff",
    "deferred_items",
    "confidence_summary"
  ],
  "properties": {
    "schema_name": {
      "const": "module2b_output_env_only"
    },
    "schema_version": {
      "const": "0.1"
    },
    "stage": {
      "const": "target_object_and_environment_constraints_env_only"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "target_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "target_mode",
        "binding_status",
        "primary_targets",
        "candidate_ids_ranked",
        "context_refs",
        "deferred_reasons",
        "confidence"
      ],
      "properties": {
        "binding_id": {
          "type": "string",
          "pattern": "^tb_[0-9]{2}$"
        },
        "target_mode": {
          "type": "string",
          "enum": ["single", "multiple", "implicit", "ambiguous", "none"]
        },
        "binding_status": {
          "type": "string",
          "enum": ["resolved", "partially_resolved", "ambiguous", "deferred"]
        },
        "primary_targets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "object_id",
              "object_name",
              "confidence",
              "evidence_keys",
              "context_refs"
            ],
            "properties": {
              "object_id": {
                "type": "string",
                "pattern": "^obj_[0-9]{2}$"
              },
              "object_name": { "type": "string" },
              "confidence": {
                "type": "number",
                "minimum": 0.0,
                "maximum": 1.0
              },
              "evidence_keys": {
                "type": "array",
                "items": { "type": "string" },
                "uniqueItems": true
              },
              "context_refs": {
                "type": "array",
                "items": { "type": "string" },
                "uniqueItems": true
              }
            }
          }
        },
        "candidate_ids_ranked": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^obj_[0-9]{2}$"
          },
          "uniqueItems": true
        },
        "context_refs": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "deferred_reasons": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      }
    },
    "environment_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topology_tags", "relevant_structures", "access_path_profile", "numeric_estimates"],
      "properties": {
        "topology_tags": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tag_id", "label", "confidence", "source_refs"],
            "properties": {
              "tag_id": {
                "type": "string",
                "pattern": "^tag_[0-9]{2}$"
              },
              "label": {
                "type": "string",
                "enum": [
                  "container_neck",
                  "recess_wall",
                  "partial_opening",
                  "deep_recess",
                  "through_opening",
                  "narrow_gap",
                  "constraining_surface_pair",
                  "confined_channel",
                  "under_overhang",
                  "occluding_edge",
                  "container_cavity",
                  "support_surface",
                  "contact_plane",
                  "obstacle"
                ]
              },
              "confidence": {
                "type": "number",
                "minimum": 0.0,
                "maximum": 1.0
              },
              "source_refs": {
                "type": "array",
                "items": { "type": "string" },
                "minItems": 1,
                "uniqueItems": true
              }
            }
          }
        },
        "relevant_structures": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "environment_structure_id",
              "structure_role",
              "topology_tags",
              "related_object_ids",
              "evidence",
              "source_refs",
              "confidence"
            ],
            "properties": {
              "environment_structure_id": {
                "type": "string",
                "pattern": "^env_[0-9]{2}$"
              },
              "structure_role": {
                "type": "string",
                "enum": [
                  "container_neck",
                  "recess_wall",
                  "partial_opening",
                  "deep_recess",
                  "through_opening",
                  "narrow_gap",
                  "constraining_surface_pair",
                  "confined_channel",
                  "under_overhang",
                  "occluding_edge",
                  "container_cavity",
                  "support_surface",
                  "contact_plane",
                  "obstacle"
                ]
              },
              "topology_tags": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "container_neck",
                    "recess_wall",
                    "partial_opening",
                    "deep_recess",
                    "through_opening",
                    "narrow_gap",
                    "constraining_surface_pair",
                    "confined_channel",
                    "under_overhang",
                    "occluding_edge",
                    "container_cavity",
                    "support_surface",
                    "contact_plane",
                    "obstacle"
                  ]
                },
                "uniqueItems": true
              },
              "related_object_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^obj_[0-9]{2}$"
                },
                "uniqueItems": true
              },
              "evidence": {
                "type": "array",
                "items": { "type": "string" }
              },
              "source_refs": {
                "type": "array",
                "items": { "type": "string" },
                "minItems": 1,
                "uniqueItems": true
              },
              "confidence": {
                "type": "number",
                "minimum": 0.0,
                "maximum": 1.0
              }
            }
          }
        },
        "access_path_profile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "entry_mode",
            "rotation_clearance",
            "requires_pass_through_opening",
            "requires_deep_reach",
            "available_support_surface",
            "slip_hazard_present",
            "confinement_level"
          ],
          "properties": {
            "entry_mode": {
              "type": "string",
              "enum": ["top_entry", "side_entry", "angled_entry", "front_entry"]
            },
            "rotation_clearance": {
              "type": "string",
              "enum": ["sufficient", "limited", "severely_limited"]
            },
            "requires_pass_through_opening": { "type": "boolean" },
            "requires_deep_reach": { "type": "boolean" },
            "available_support_surface": { "type": "boolean" },
            "slip_hazard_present": { "type": "boolean" },
            "confinement_level": {
              "type": "integer",
              "enum": [1, 2, 3]
            }
          }
        },
        "numeric_estimates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "measurement_id",
              "parameter_name",
              "unit",
              "bound_type",
              "lower_value",
              "upper_value",
              "estimate_basis",
              "related_environment_structure_ids",
              "source_refs",
              "confidence"
            ],
            "properties": {
              "measurement_id": {
                "type": "string",
                "pattern": "^m_[0-9]{2}$"
              },
              "parameter_name": {
                "type": "string",
                "enum": [
                  "opening_width",
                  "opening_height",
                  "neck_inner_diameter",
                  "recess_depth",
                  "reachable_depth",
                  "lateral_clearance",
                  "vertical_clearance",
                  "available_entry_angle_deg",
                  "target_exposed_edge_length",
                  "support_surface_span"
                ]
              },
              "unit": {
                "type": "string",
                "enum": ["m", "deg", "level_1_to_5"]
              },
              "bound_type": {
                "type": "string",
                "enum": ["range", "upper_bound", "lower_bound"]
              },
              "lower_value": { "type": ["number", "null"] },
              "upper_value": { "type": ["number", "null"] },
              "estimate_basis": {
                "type": "string",
                "enum": [
                  "observed",
                  "estimated_from_anchor",
                  "relative_geometry",
                  "task_text_prior"
                ]
              },
              "related_environment_structure_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^env_[0-9]{2}$"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "source_refs": {
                "type": "array",
                "items": { "type": "string" },
                "minItems": 1,
                "uniqueItems": true
              },
              "confidence": {
                "type": "number",
                "minimum": 0.0,
                "maximum": 1.0
              }
            }
          }
        }
      }
    },
    "derived_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constraint_catalog", "global_constraint_ids", "subgoal_bindings"],
      "properties": {
        "constraint_catalog": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "constraint_id",
              "category",
              "parameter_name",
              "applies_to",
              "hardness",
              "priority",
              "bound_type",
              "unit",
              "lower_value",
              "upper_value",
              "measurement_ids",
              "target_binding_ids",
              "source_refs",
              "subgoal_ids",
              "confidence"
            ],
            "properties": {
              "constraint_id": {
                "type": "string",
                "pattern": "^c_[0-9]{2}$"
              },
              "category": {
                "type": "string",
                "enum": ["geometric", "mechanical", "surface_interaction", "stability_access"]
              },
              "parameter_name": {
                "type": "string",
                "enum": [
                  "min_effective_reach",
                  "max_tool_body_width",
                  "max_cross_section_width",
                  "max_tip_thickness",
                  "max_tip_diameter",
                  "min_insert_depth",
                  "min_contact_span",
                  "min_tip_force_transmission_level",
                  "min_global_stiffness_level",
                  "max_allowed_compliance_level",
                  "min_surface_friction_level",
                  "preferred_contact_friction_level",
                  "min_placement_stability_level",
                  "max_required_entry_angle_deg",
                  "max_allowed_roll_instability_level"
                ]
              },
              "applies_to": {
                "type": "string",
                "enum": ["tool_profile", "approach_path", "placement_strategy"]
              },
              "hardness": {
                "type": "string",
                "enum": ["hard", "soft"]
              },
              "priority": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              },
              "bound_type": {
                "type": "string",
                "enum": ["range", "upper_bound", "lower_bound"]
              },
              "unit": {
                "type": "string",
                "enum": ["m", "deg", "level_1_to_5"]
              },
              "lower_value": { "type": ["number", "null"] },
              "upper_value": { "type": ["number", "null"] },
              "measurement_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^m_[0-9]{2}$"
                },
                "uniqueItems": true
              },
              "target_binding_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^tb_[0-9]{2}$"
                },
                "uniqueItems": true
              },
              "source_refs": {
                "type": "array",
                "items": { "type": "string" },
                "minItems": 1,
                "uniqueItems": true
              },
              "subgoal_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^sg_[0-9]{2}$"
                },
                "uniqueItems": true
              },
              "confidence": {
                "type": "number",
                "minimum": 0.0,
                "maximum": 1.0
              }
            }
          }
        },
        "global_constraint_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^c_[0-9]{2}$"
          },
          "uniqueItems": true
        },
        "subgoal_bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["subgoal_id", "constraint_ids"],
            "properties": {
              "subgoal_id": {
                "type": "string",
                "pattern": "^sg_[0-9]{2}$"
              },
              "constraint_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^c_[0-9]{2}$"
                },
                "uniqueItems": true
              }
            }
          }
        }
      }
    },
    "module3_handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handoff_status",
        "constraint_units_policy",
        "handoff_constraint_ids",
        "pending_merge_sources",
        "omitted_constraint_families",
        "notes"
      ],
      "properties": {
        "handoff_status": {
          "type": "string",
          "enum": ["ready", "partial", "blocked"]
        },
        "constraint_units_policy": {
          "type": "string",
          "enum": ["metric_strict", "mixed_metric_and_ordinal", "ordinal_preferred"]
        },
        "handoff_constraint_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^c_[0-9]{2}$"
          },
          "uniqueItems": true
        },
        "pending_merge_sources": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "omitted_constraint_families": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "risk_limit",
              "target_material_state",
              "damage_sensitivity",
              "contact_style_preference"
            ]
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "deferred_items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unresolved_target_ambiguities",
        "unresolved_environment_ambiguities",
        "not_numericized_items",
        "needs_user_or_scale_anchor"
      ],
      "properties": {
        "unresolved_target_ambiguities": { "$ref": "#/$defs/deferred_list" },
        "unresolved_environment_ambiguities": { "$ref": "#/$defs/deferred_list" },
        "not_numericized_items": { "$ref": "#/$defs/deferred_list" },
        "needs_user_or_scale_anchor": { "$ref": "#/$defs/deferred_list" }
      }
    },
    "confidence_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_binding_confidence",
        "environment_binding_confidence",
        "constraint_set_confidence",
        "high_impact_uncertainties"
      ],
      "properties": {
        "target_binding_confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "environment_binding_confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "constraint_set_confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "high_impact_uncertainties": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    }
  },
  "$defs": {
    "deferred_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item", "reason", "source_refs"],
      "properties": {
        "item": { "type": "string" },
        "reason": { "type": "string" },
        "source_refs": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "deferred_list": {
      "type": "array",
      "items": { "$ref": "#/$defs/deferred_item" }
    }
  }
}
