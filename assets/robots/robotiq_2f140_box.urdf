<?xml version="1.0"?>
<robot name="robotiq_2f140_box">
  <link name="base">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.6"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.075 0.040 0.035"/>
      </geometry>
      <material name="dark_gray">
        <color rgba="0.08 0.08 0.08 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.075 0.040 0.035"/>
      </geometry>
    </collision>
  </link>

  <link name="left_finger">
    <inertial>
      <origin xyz="0 0 0.045"/>
      <mass value="0.12"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.00005"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.060"/>
      <geometry>
        <box size="0.026 0.014 0.120"/>
      </geometry>
      <material name="rubber_black">
        <color rgba="0.015 0.015 0.015 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.060"/>
      <geometry>
        <box size="0.026 0.014 0.120"/>
      </geometry>
    </collision>
  </link>

  <link name="right_finger">
    <inertial>
      <origin xyz="0 0 0.045"/>
      <mass value="0.12"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.00005"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.060"/>
      <geometry>
        <box size="0.026 0.014 0.120"/>
      </geometry>
      <material name="rubber_black">
        <color rgba="0.015 0.015 0.015 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.060"/>
      <geometry>
        <box size="0.026 0.014 0.120"/>
      </geometry>
    </collision>
  </link>

  <joint name="left_finger_joint" type="prismatic">
    <parent link="base"/>
    <child link="left_finger"/>
    <origin xyz="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="0.077" effort="250" velocity="0.35"/>
    <dynamics damping="0.2" friction="0.01"/>
  </joint>

  <joint name="right_finger_joint" type="prismatic">
    <parent link="base"/>
    <child link="right_finger"/>
    <origin xyz="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0.0" upper="0.077" effort="250" velocity="0.35"/>
    <dynamics damping="0.2" friction="0.01"/>
  </joint>
</robot>
